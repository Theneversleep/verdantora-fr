---
import Button from "./Button.astro";
import Heading from "./Heading.astro";
import Photo from "./Photo.astro";
---

<section id="votre-jardin-de-reve" class="cover inset final-cta">
  <Photo class="backdrop" name="calltoaction-1" />
  <div>
    <Heading
      label="Lancez-vous"
      title="Votre jardin de rêve commence ici."
      description="Vous imaginez déjà votre jardin ? Ensemble, donnons vie à vos idées pour créer un espace naturel et accueillant, à votre image."
    />
    <Button href="mailto:hello@verdantora.com?subject=Demande%20de%20devis">
      Demander un devis gratuit
    </Button>
  </div>
</section>
