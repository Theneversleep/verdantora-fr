---
import Feature from "./Feature.astro";
const items = [
  {
    title: "Inspiré par la nature",
    text: "Des espaces extérieurs à votre image.",
  },
  {
    title: "Un travail soigné",
    text: "Le souci du détail, du début à la fin.",
  },
  {
    title: "Un service personnalisé",
    text: "Des projets pensés selon vos besoins.",
  },
  {
    title: "Un entretien régulier",
    text: "Votre jardin suivi au fil des saisons.",
  },
];
const icons = ["plant", "award", "care", "time"];
---

<section class="trust wrap" aria-label="Nos engagements">
  {items.map((item, i) => (
    <Feature {...item} icon={icons[i]} />
  ))}
</section>
