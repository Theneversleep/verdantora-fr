---
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import { links } from "../data/navigation.js";
---

<nav class="navigation" aria-label="Navigation principale">
  <a class="brand" href="#accueil">
    <span>
      <Icon />
    </span>{" "}
    Verdantora
  </a>
  <button
    class="burger"
    aria-label="Menu"
    aria-controls="nav-links"
    aria-expanded="false"
  >
    <i></i>
    <i></i>
    <i></i>
  </button>
  <div class="nav-links" id="nav-links">
    {links.map(([label, href]) => (
      <a href={href}>{label}</a>
    ))}
    <Button href="mailto:hello@verdantora.com?subject=Demande%20de%20devis">
      Devis gratuit
    </Button>
  </div>
</nav>
