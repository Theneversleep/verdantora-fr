---
import Heading from "./Heading.astro";
import Icon from "./Icon.astro";
const items = [
  {
    service: "Conception paysagère",
    quote:
      "« Nous rêvions d’un jardin paisible où les enfants auraient aussi leur place. Les croquis de Verdantora nous ont permis de nous projeter. Le résultat dépasse ce qu’on imaginait. »",
    name: "Hannah Ellison",
    place: "Propriétaire à Laurelhurst",
  },
  {
    service: "Création de jardins",
    quote:
      "« Tout avait été pensé, jusqu’à la dernière pierre de bordure. L’équipe arrivait à l’heure, laissait le chantier propre et nous a montré comment entretenir chaque massif avant de partir. »",
    name: "Priya Raman",
    place: "Propriétaire à Sellwood",
  },
  {
    service: "Création de pelouses",
    quote:
      "« Notre pelouse était clairsemée depuis des années. Six semaines après la pose du gazon, les enfants y jouaient tous les soirs. Le prix était clair dès le départ, sans surprise. »",
    name: "Daniel Ortiz",
    place: "Propriétaire à Lake Oswego",
  },
  {
    service: "Vie en plein air",
    quote:
      "« On passe désormais plus de temps sur la terrasse que dans le salon. Avec le coin détente sur gravier et les rosiers grimpants, les soirs d’été ont un air de vacances. »",
    name: "Claire Whitmore",
    place: "Propriétaire à Alameda",
  },
  {
    service: "Entretien de jardins",
    quote:
      "« Une visite par mois suffit pour que le jardin reste impeccable sans qu’on ait à s’en occuper. Ils repèrent les soucis très tôt. On a sauvé des plantes et fait des économies. »",
    name: "James Holloway",
    place: "Propriétaire à Hillsdale",
  },
  {
    service: "Soins saisonniers",
    quote:
      "« Après leur passage en automne, les bordures étaient nettes et prêtes pour l’hiver. Au printemps, tout a repoussé avec encore plus de vigueur que l’année précédente. »",
    name: "Sofia Brandt",
    place: "Propriétaire à Beaverton",
  },
];
const rows = [items.slice(0, 3), items.slice(3)];
---

<section id="temoignages" class="block wrap reviews">
  <Heading label="Témoignages" title="La parole aux amoureux du jardin." />
  <div class="review-rows">
    {rows.map((row) => (
      <div class="review-lane">
        <div class="review-track">
          {[false, true].map((duplicate) => (
            <div class="review-group" aria-hidden={duplicate || undefined}>
              {row.map((item) => (
                <figure class="review">
                  <div>
                    <span class="icon-tile">❞</span>
                    <small>{item.service}</small>
                  </div>
                  <blockquote>{item.quote}</blockquote>
                  <figcaption>
                    <Icon name="plant" />
                    <span>
                      <strong>{item.name}</strong>
                      <br />
                      {item.place}
                    </span>
                  </figcaption>
                </figure>
              ))}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
  <button class="review-toggle" type="button" hidden>Mettre en pause</button>
</section>
