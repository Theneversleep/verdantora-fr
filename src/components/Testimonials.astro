<script is:inline>
for(const carousel of document.querySelectorAll('#temoignages [data-framer-name="Testimonial Carousel"]')){
  const track=carousel.querySelector('.review-track');
  for(const button of carousel.querySelectorAll('[role="button"]')){
    function navigate(){
      const forward=button.dataset.framerName==='Next';
      const limit=track.scrollWidth-track.clientWidth;
      const stops=[...new Set(Array.from(track.querySelectorAll('li'),card=>Math.min(card.offsetLeft,limit)))];
      const target=forward ? stops.find(x=>x>track.scrollLeft+2)??0 : stops.reverse().find(x=>x<track.scrollLeft-2)??limit;
      track.scrollTo({left:target,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});
    }
    button.addEventListener('click',navigate);
    button.addEventListener('keydown',event=>{
      if(event.key==='Enter'||event.key===' '){event.preventDefault();navigate()}
    });
  }
}
</script>
