---
import Heading from "./Heading.astro";
import Icon from "./Icon.astro";
import Photo from "./Photo.astro";
import { links } from "../data/navigation.js";
---

<footer class="cover site-footer">
  <Photo name="footer-1" class="backdrop" />
  <div class="footer-inner">
    <section id="newsletter" class="newsletter">
      <Heading
        label="Newsletter"
        title="Un peu de verdure dans votre boîte mail."
        description="Recevez des idées pour votre jardin, des conseils de saison et de l’inspiration pour aménager vos extérieurs."
      />
      <form>
        <input
          required
          type="email"
          autocomplete="email"
          aria-label="Votre adresse e-mail"
          placeholder="Votre adresse e-mail"
        />
        <button class="button dark">
          S’inscrire{" "}
          <span>
            <Icon />
          </span>
        </button>
      </form>
      <small>
        En vous inscrivant, vous acceptez de recevoir les actualités de
        Verdantora. Vous pouvez vous désinscrire à tout moment.
      </small>
      <p role="status" hidden>
        Formulaire de démonstration : votre adresse n’a pas été enregistrée.
      </p>
    </section>
    <div id="pied-de-page" class="footer-cols">
      <div>
        <a class="brand" href="#accueil">
          <span>
            <Icon />
          </span>
          Verdantora
        </a>
        <p>
          Verdantora conçoit des jardins où la nature et la beauté trouvent leur
          place dans la vie de tous les jours.
        </p>
      </div>
      <div>
        <b>Explorer</b>
        {links.map(([label, href]) => (
          <a {href}>{label}</a>
        ))}
      </div>
      <div>
        <b>Contact</b>
        <a href="mailto:hello@verdantora.com">hello@verdantora.com</a>
        <a href="tel:+15035550148">+1 (503) 555-0148</a>
        <p>
          123 Greenway Lane
          <br />
          Portland, OR 97205
        </p>
      </div>
      <div>
        <b>Informations légales</b>
        <a href="#confidentialite">Politique de confidentialité</a>
        <a href="#conditions">Conditions générales</a>
      </div>
    </div>
    <div class="wordmark" data-reveal>
      Verdantora
    </div>
    <div class="copyright">
      <span>© 2026 Verdantora. Tous droits réservés.</span>
      <a href="#confidentialite">Politique de confidentialité</a>
      <a href="#conditions">Conditions générales</a>
    </div>
  </div>
</footer>
