---
import Heading from "./Heading.astro";
import Button from "./Button.astro";
import Photo from "./Photo.astro";
import Icon from "./Icon.astro";
const items = [
  {
    number: "01",
    time: "Jour 1 · Visite gratuite",
    title: "Parlez-nous de vos envies",
    text: "Partagez vos envies et vos habitudes. Sur place, nous étudions le terrain et prenons les mesures.",
  },
  {
    number: "02",
    time: "Semaines 1 à 2 · Conception",
    title: "Dessinons votre jardin",
    text: "Nous préparons un plan d’aménagement, un plan de plantation et un devis détaillé. Ensemble, nous les ajustons selon vos envies.",
  },
  {
    number: "03",
    time: "Semaines 3 à 6 · Réalisation",
    title: "Place aux travaux",
    text: "Notre équipe prépare le sol, trace les allées, crée les massifs et met les végétaux en terre en perturbant le moins possible votre quotidien.",
  },
  {
    number: "04",
    time: "Au fil des saisons · Entretien",
    title: "Profitez de votre jardin",
    text: "Apprenez les bons gestes et profitez de visites saisonnières pour garder votre jardin en pleine santé.",
  },
];
const icons = ["chat", "detail", "care", "plant"];
---

<section id="notre-processus" class="inset dark-panel">
  <div class="block wrap split">
    <div>
      <Heading
        label="Notre processus"
        title="Votre jardin en quatre étapes, en toute sérénité."
        description="De la première idée au jardin aménagé, nous avançons avec vous à chaque étape."
      />
      <figure class="visit" data-reveal>
        <Photo name="process-1" />
        <small>Visite gratuite sur place</small>
      </figure>
      <Button href="mailto:hello@verdantora.com?subject=Demande%20de%20visite%20gratuite">
        Réserver une visite gratuite
      </Button>
    </div>
    <div class="steps grid">
      {items.map((step, i) => (
        <article data-reveal>
          <div class="step-icons">
            <b>{step.number}</b>
            <i></i>
            <Icon name={icons[i]} />
          </div>
          <small>{step.time}</small>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
