<script is:inline>
for(const head of document.querySelectorAll('#faq [aria-controls]')){
  const card=head.parentElement;
  const answer=document.getElementById(head.getAttribute('aria-controls'));
  function toggleAnswer(){
    const open=answer.hidden;
    answer.hidden=!open;
    head.setAttribute('aria-expanded',String(open));
    card.dataset.framerName=open?'Open':'Closed';
    card.classList.toggle('framer-v-oqgosc',open);
    card.classList.toggle('framer-v-1bs6yvs',!open);
    head.querySelector('use').setAttribute('href',open?'#faq-minus':'#465907804');
  }
  head.addEventListener('click',toggleAnswer);
  head.addEventListener('keydown',event=>{
    if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleAnswer()}
  });
}
</script>
