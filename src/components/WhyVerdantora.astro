---
import Heading from "./Heading.astro";
import Photo from "./Photo.astro";
import Feature from "./Feature.astro";
const items = [
  {
    title: "Un jardin à votre image",
    text: "Chaque projet commence par vos idées, vos priorités et les particularités de votre terrain.",
  },
  {
    title: "Des choix guidés par la nature",
    text: "Nous choisissons des végétaux qui respectent le caractère de votre jardin et le font évoluer au fil des saisons.",
  },
  {
    title: "Le souci du détail",
    text: "Du tracé des allées aux dernières finitions, chaque élément a sa place et sa raison d’être.",
  },
  {
    title: "Des échanges clairs",
    text: "À chaque étape, vous savez où en est votre projet et ce qui vous attend.",
  },
];
const icons = ["vision", "leaf", "detail", "chat"];
---

<section id="pourquoi-verdantora" class="block wrap split">
  <div>
    <Heading
      label="Pourquoi Verdantora"
      title="Vos envies. Notre main verte."
      description="Dans un jardin réussi, les plantes, les allées et les espaces de vie trouvent leur équilibre. Nous pensons chaque aménagement en fonction de ce que vous aimez et de la façon dont vous souhaitez vivre dehors."
    />
    <div class="features grid">
      {items.map((item, i) => (
        <Feature {...item} icon={icons[i]} />
      ))}
    </div>
  </div>
  <figure data-reveal>
    <Photo
      name="whyverdantora-1"
      alt="Vue aérienne du jardin et de ses allées"
    />
  </figure>
</section>
