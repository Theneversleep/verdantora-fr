---
import Heading from "./Heading.astro";
import Button from "./Button.astro";
import Photo from "./Photo.astro";
const items = [
  {
    title: "Conception paysagère",
    text: "Donnons forme à vos idées avec un plan qui soigne les associations de plantes, les circulations et les détails.",
  },
  {
    title: "Création de jardins",
    text: "Nous donnons vie à votre jardin en choisissant des végétaux, en créant des massifs et en harmonisant les aménagements.",
  },
  {
    title: "Création de pelouses",
    text: "Offrez-vous une pelouse verdoyante pour les repas en plein air, les après-midi tranquilles et les plaisirs du quotidien.",
  },
  {
    title: "Entretien de jardins",
    text: "Tonte, taille et nettoyage au fil des saisons pour garder votre jardin en pleine forme.",
  },
  {
    title: "Espaces de vie extérieurs",
    text: "Des allées aux terrasses, nous dessinons des lieux accueillants pour vous détendre et recevoir.",
  },
  {
    title: "Soins saisonniers",
    text: "Préparez votre jardin à chaque changement de saison avec un nettoyage, de nouvelles plantations et des soins adaptés.",
  },
];
const ids = [
  "conception",
  "plantations",
  "pelouse",
  "entretien",
  "terrasse",
  "saisons",
];
---

<section id="nos-services" class="block tint">
  <div class="wrap">
    <div class="section-intro">
      <Heading
        label="Nos services"
        title="Tout pour voir votre jardin s’épanouir."
      />
      <div data-reveal>
        <p>
          De la première esquisse aux soins de saison, nous aménageons des
          espaces agréables à vivre et faciles à entretenir.
        </p>
        <Button href="#prestations" tone="dark">
          Voir tous nos services
        </Button>
      </div>
    </div>
    <div class="services grid">
      {items.map((item, i) => (
        <a data-reveal class="service cover" href={"#" + ids[i]}>
          <Photo name={"services-" + (i + 1)} class="backdrop" />
          <div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
