---
import Heading from "./Heading.astro";
import Button from "./Button.astro";
import Photo from "./Photo.astro";
const items = [
  {
    date: "Achevé en 2025",
    title: "Un jardin refuge",
    category: "Conception d’un jardin privé",
  },
  {
    date: "Achevé en 2025",
    title: "Une entrée accueillante",
    category: "Réaménagement du jardin de devant",
  },
  {
    date: "Achevé en 2024",
    title: "Une échappée au grand air",
    category: "Terrasse et espace de vie extérieur",
  },
  {
    date: "Achevé en 2024",
    title: "Un nouveau souffle au jardin",
    category: "Rénovation de la pelouse et des massifs",
  },
];
const photos = ["projects-1", "projects-2", "projects-3", "about-2"];
const ids = [
  "the-garden-retreat",
  "the-welcoming-entrance",
  "the-outdoor-escape",
  "the-green-refresh",
];
---

<section id="projets-a-la-une" class="block tint">
  <div class="wrap">
    <Heading
      label="Projets à la une"
      title="Des jardins à vivre."
      description="Découvrez nos jardins récents, des coins de verdure à l’abri des regards aux entrées accueillantes et aux massifs faciles à entretenir."
    />
    <div class="projects grid">
      {items.map((item, i) => (
        <a class="project" data-reveal href={"#" + ids[i]}>
          <figure>
            <Photo name={photos[i]} />
            <small>{item.date}</small>
          </figure>
          <h3>{item.title}</h3>
          <p>{item.category}</p>
        </a>
      ))}
    </div>
    <div class="center" data-reveal>
      <Button href="#realisations" tone="dark">
        Découvrir nos projets
      </Button>
      <p>Chaque projet commence par une visite gratuite sur place.</p>
    </div>
  </div>
</section>
